# Required: your Anthropic API key (the backend Claude agent uses it)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
ANTHROPIC_MODEL=claude-opus-4-8
# whisper.cpp ggml model name (resolved under WHISPER_MODELS) or an absolute path
WHISPER_MODEL=small.en
WHISPER_MODELS=~/.cache/hyperframes/whisper/models
