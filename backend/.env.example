# Auth: by DEFAULT no key is needed — the backend agent uses your logged-in
# `claude` CLI session (headless). Just have Claude Code installed and logged in.
#
# To use the Anthropic API directly instead, set a key (then the SDK is used):
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-4-8      # omit to use the session's default model
# CLAUDE_BIN=claude                    # path to the claude CLI if not on PATH
# WHISPER_MODEL=small.en               # ggml model name or absolute path
# WHISPER_MODELS=~/.cache/hyperframes/whisper/models
