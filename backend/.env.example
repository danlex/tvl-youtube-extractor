# Auth: by DEFAULT no key is needed — the backend agent uses your logged-in
# `claude` CLI session (headless). Just have Claude Code installed and logged in.
# To use the Anthropic API directly instead, set a key (then the SDK is used):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8        # omit to use the session's default model
# CLAUDE_BIN=claude                      # path to the claude CLI if not on PATH

# Transcription
# TRANSCRIBE_PREFER=captions             # captions (YouTube subs first) | asr
# ASR_BACKEND=faster-whisper             # faster-whisper | whisper-cli
# ASR_MODEL=base.en                      # tiny.en | base.en | small.en | ...
# WHISPER_MODEL=small.en                 # whisper-cli model (if ASR_BACKEND=whisper-cli)
# WHISPER_MODELS=~/.cache/hyperframes/whisper/models

# yt-dlp (for servers/VPNs that YouTube blocks)
# YTDLP_COOKIES=~/yt-cookies.txt         # cookies.txt to get past the bot-check
# YTDLP_COOKIES_FROM_BROWSER=chrome      # or pull cookies from a local browser
# YTDLP_PROXY=http://user:pass@host:port
# YTDLP_JS_RUNTIME=node                  # JS runtime for yt-dlp (node|deno)
# YTDLP_EXTRA=                           # any extra yt-dlp flags

# Housekeeping
# JOB_TTL_DAYS=7                         # delete job folders older than this
# PORT=8000
